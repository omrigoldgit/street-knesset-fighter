{
  "name": "street-knesset-fighter",
  "version": "1.0.0",
  "description": "A 2.5D satirical fighting game starring 40 members of the Knesset. Runs on PC (browser or desktop) with PS5 DualSense support.",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "author": "Street Knesset Fighter contributors",
  "license": "MIT",
  "scripts": {
    "play": "node play.mjs",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm run test && npm run build",
    "desktop": "vite build && electron .",
    "dist:win": "vite build && electron-builder --win portable zip",
    "dist:linux": "vite build && electron-builder --linux AppImage",
    "dist:mac": "vite build && electron-builder --mac dmg"
  },
  "dependencies": {
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/three": "^0.186.0",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "typescript": "~5.9.3",
    "vite": "^7.3.6",
    "vitest": "^5.0.2"
  },
  "build": {
    "appId": "com.streetknesset.fighter",
    "productName": "Street Knesset Fighter",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "portable",
        "zip"
      ],
      "signAndEditExecutable": false
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Game"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.games"
    }
  }
}
